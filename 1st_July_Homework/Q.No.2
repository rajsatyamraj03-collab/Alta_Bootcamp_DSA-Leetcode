#include <iostream>
using namespace std;
int main()
{
int n;
    cin >> n;
    
    int arr[n];

    // Input array
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    // Assume first element is minimum
    int minimum = arr[0];
    // Find the smallest element
    for(int i = 1; i < n; i++)
    {
        if(arr[i] < minimum)
            minimum = arr[i];
    }
    // Print minimum value
    cout << minimum;
    return 0;
}

//Approach and time complexity of this code is following:-
->-> Assuming the first element is min and then traversing the array and if any small element is found then we are updating our min value .

Time complexity :- 0(n);
