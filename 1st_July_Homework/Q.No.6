#include <iostream>
using namespace std;
int main()
{
int n;
cin >> n;

    int arr[n];
// Reading the  array
for(int i = 0; i < n; i++)
 cin >> arr[i];

   bool sorted = true;

// Check sorted order
    for(int i = 1; i < n; i++)
    {
        if(arr[i] < arr[i - 1])
        {
            sorted = false;
            break;
        }
    }
 // Print result
    if(sorted)
        cout << "YES";
    else
        cout << "NO";

    return 0;
}

//Approach and time complexity of this code is following:-
->Traversing  the array from the second element and comparing each with its previous element if any element is smaller then return false (means array is not sorted) otherwise sorted.

Time Complexity:-0(n)
