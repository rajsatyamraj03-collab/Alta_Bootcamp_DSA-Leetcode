#include <iostream>
using namespace std;
int main()
{
int n;
cin >> n;

int arr[n];
// Input array elements
    for(int i = 0; i < n; i++)
        cin >> arr[i];
// Assume first element is maximum
    int maximum = arr[0];
// Find the largest element
    for(int i = 1; i < n; i++)
    {
        if(arr[i] > maximum)
            maximum = arr[i];
    }
    // Display result
    cout << maximum;

    return 0;
}

//Approach and time complexity of this code is following:-

-> Assuming the first element is max and then traversing the array and if any large element is found then we are updating our max value .
Time complexity :- 0(n);
